<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_base"
        model="ir.ui.view">
        <field name="name">res.users.view.form.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id"
            ref="base.view_users_form"/>
        <field name="arch"
            type="xml">
            <xpath expr="//page[@name='access_rights']/group[1]"
                position="after">
                <group string="Autorización de compras">
                    <field name="can_authorize_purchase"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
